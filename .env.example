# AI provider: openai or litellm
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
AI_API_KEY=replace-me
# USD per 1M tokens. Update rates from your provider billing page.
AI_MODEL_PRICING_JSON={}

# LiteLLM reads provider-specific environment variables, for example:
# ANTHROPIC_API_KEY=replace-me
# GEMINI_API_KEY=replace-me
# AI_PROVIDER=litellm
# AI_MODEL=anthropic/claude-sonnet-4-5

MAX_LOG_CHARACTERS=50000
MAX_UPLOAD_SIZE_BYTES=10485760

# SQLite
DATABASE_URL=sqlite+aiosqlite:///./incident_investigator.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost/incident_investigator
# MySQL: mysql+aiomysql://user:password@localhost/incident_investigator
DATABASE_ECHO=false
DATABASE_AUTO_CREATE=true

# Log storage: local or s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/logs

# S3 / MinIO example
# STORAGE_BACKEND=s3
# S3_BUCKET=incident-logs
# S3_PREFIX=uploads
# S3_ENDPOINT_URL=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_USE_SSL=false

ALLOWED_LOG_EXTENSIONS=.log,.txt,.out,.err,.json,.jsonl,.csv,.yaml,.yml
ALLOWED_LOG_CONTENT_TYPES=text/plain,text/csv,application/json,application/x-ndjson,application/yaml,text/yaml,application/octet-stream
REJECT_BINARY_LOGS=true

MAX_PROBLEM_DESCRIPTION_CHARACTERS=5000

# Multi-user sessions
SESSION_SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=incident_investigator_session
SESSION_MAX_AGE_SECONDS=604800
SESSION_HTTPS_ONLY=false
REGISTRATION_ENABLED=true

# Recursive support-bundle analysis
MAX_ARCHIVE_UPLOAD_SIZE_BYTES=524288000
MAX_ARCHIVE_EXTRACTED_SIZE_BYTES=2147483648
MAX_ARCHIVE_FILE_COUNT=20000
MAX_ARCHIVE_DEPTH=5
MAX_SINGLE_EXTRACTED_FILE_SIZE_BYTES=209715200
MAX_COMPRESSION_RATIO=200
ARCHIVE_TIME_WINDOW_MINUTES=15
MAX_ARCHIVE_AI_CHARACTERS=250000
MAX_ARTIFACT_EXCERPT_CHARACTERS=8000
REDACT_SECRETS_BEFORE_AI=true
ALLOW_RAW_ARTIFACT_DOWNLOAD=false

# Optional GitHub / GitHub Enterprise source-code correlation
# When disabled, the investigator still extracts file/function/line hints directly from logs.
GITHUB_ENABLED=false
GITHUB_SOURCE_LOOKUP_ENABLED=true
# GitHub Enterprise Server example: https://github.company.example
# GitHub.com example: https://github.com
GITHUB_BASE_URL=https://github.com
# Optional API override. Leave blank to derive it from GITHUB_BASE_URL.
# For GHES the default is <GITHUB_BASE_URL>/api/v3.
# GITHUB_API_URL=https://github.company.example/api/v3
GITHUB_TOKEN=
# Optional organization scope for code search. Leave blank to search all repositories
# visible to the configured read-only token.
GITHUB_ORGANIZATION=
# Leave blank to use each repository's default branch. Set only when your environment
# requires a fixed branch for source lookup.
GITHUB_DEFAULT_BRANCH=
GITHUB_CONTEXT_LINES=25
GITHUB_MAX_SEARCH_RESULTS=5
GITHUB_MAX_CANDIDATES=8
GITHUB_MAX_QUERIES=6
GITHUB_TIMEOUT_SECONDS=10
GITHUB_VERIFY_SSL=true
